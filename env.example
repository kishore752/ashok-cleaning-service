# Frontend (Vite) – create .env or .env.local with these for local dev
# In Supabase: Project Settings → API → use Project URL + Publishable key (not the Secret)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Netlify site env (Dashboard → Site settings → Environment variables)
# SENDGRID_API_KEY=...
# SENDGRID_FROM_EMAIL=...
# ADMIN_EMAIL=...
# SEND_CUSTOMER_CONFIRMATION=true
# NOTIFICATION_SECRET=optional-secret-to-call-send-notification
